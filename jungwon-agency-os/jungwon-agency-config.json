{
  "agency": {
    "id": "jungwon",
    "name": "JungWon Self-Improving AI Agency",
    "version": "1.0.0",
    "description": "Paperclip + Hermes + Ganma4 + Kimi K3 기반 자기발전형 AI 에이전시",
    "author": "User",
    "status": "Active"
  },
  "default_company_id": "0edd5dab-bd43-411f-b120-d72ccf9686a0",
  "core_systems": {
    "paperclip": {
      "enabled": true,
      "base_url": "http://127.0.0.1:3100",
      "api_prefix": "/api",
      "mode": "local_trusted"
    },
    "hermes": {
      "enabled": true,
      "platform": "telegram",
      "bridge_mode": "auto",
      "adapter_type": "hermes_agent_v2",
      "version": "2.0.0",
      "features": [
        "SOUL_v2",
        "multi_llm_failover",
        "memory_rag",
        "capcut_auto"
      ]
    },
    "ganma4": {
      "enabled": true,
      "sub_language": true,
      "model": "gemma4:e4b",
      "base_url": "http://127.0.0.1:11434",
      "context_window": 8192,
      "capabilities": [
        "reasoning",
        "code_generation",
        "analysis",
        "Korean_native"
      ]
    },
    "kimi_k3": {
      "enabled": true,
      "model": "kimi-k3",
      "provider": "moonshot",
      "api_url": "https://api.moonshot.cn/v1",
      "api_key_env": "KIMI_API_KEY",
      "context_window": 128000,
      "capabilities": [
        "deep_reasoning",
        "long_context",
        "analysis",
        "Korean_native",
        "code_generation"
      ]
    },
    "nvidia_nemotron": {
      "enabled": true,
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "provider": "nvidia_build",
      "api_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "context_window": 128000,
      "capabilities": [
        "ultra_high_reasoning",
        "flagship_ai",
        "architecture_planning",
        "Korean_native",
        "code_generation"
      ]
    },
    "autonomous_brain": {
      "enabled": true,
      "module": "autonomous_strategic_brain.py",
      "auto_dispatch": true
    },
    "smart_router": {
      "enabled": true,
      "module": "smart_llm_router.py",
      "failover_mode": "adaptive",
      "default_preference": "auto",
      "routing_strategy": "triple_hybrid_nvidia_nemotron_kimi_k3_ganma4"
    },
    "multi_agent_critic": {
      "enabled": true,
      "module": "multi_agent_critic.py",
      "quality_threshold": 80
    },
    "dynamic_skill_synthesizer": {
      "enabled": true,
      "module": "dynamic_skill_synthesizer.py",
      "auto_load": true
    },
    "capcut_editor": {
      "enabled": true,
      "module": "capcut_automation.py",
      "engine": "vibecut",
      "auto_subtitles": true,
      "silence_cut": true
    }
  },
